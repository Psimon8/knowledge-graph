# Streamlit Secrets Configuration
# This file shows the format for secrets when deploying to Streamlit Cloud

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-your-openai-api-key-here"

# Instructions for local development:
# 1. Copy this file to .streamlit/secrets.toml
# 2. Replace the API key with your actual key
# 3. This file is already in .gitignore, so it won't be committed

# Instructions for Streamlit Cloud:
# 1. Go to your app dashboard on share.streamlit.io
# 2. Click "Settings" > "Secrets"
# 3. Paste the content above with your real API key
# 4. Save and your app will restart automatically
